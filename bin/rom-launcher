#!/bin/bash
# rom-launcher — Steam shortcut launcher for the Tender plugin.
# Steam invokes it with the full launch command (emulator invocation + ROM
# path) in the shortcut's launch options. Pure exec wrapper: it runs exactly
# what it is handed and owns no state, no path resolution, no emulator knowledge.
#
# Fork addition (0.33.1-msu3): frame generation via decky-lsfg-vk.
# When the decky-lsfg-vk launch script (~/lsfg) exists, games whose ROM sits in
# one of the chosen RetroDECK system folders (…/roms/<system>/…) are started
# through it, so no shortcut has to be edited by hand. The systems are read
# from ~/.config/romm-tender/lsfg-systems (names separated by spaces or lines,
# `#` starts a comment, `*` means every system; an empty file turns it off).
# Without that file the default is the systems whose games mostly run at
# 30 fps: ps2 gc wii wiiu n3ds ps3 switch.

set -euo pipefail

if [[ $# -eq 0 ]]; then
    echo "Usage: rom-launcher <command> [args...]" >&2
    exit 1
fi

lsfg_script="${HOME:-}/lsfg"
lsfg_conf="${XDG_CONFIG_HOME:-${HOME:-}/.config}/romm-tender/lsfg-systems"
lsfg_default="ps2 gc wii wiiu n3ds ps3 switch"

lsfg_wanted() {
    [[ -n ${HOME:-} && -x $lsfg_script && ! -d $lsfg_script ]] || return 1
    local systems
    if [[ -f $lsfg_conf ]]; then
        systems=$(sed 's/#.*//' -- "$lsfg_conf" | tr '\n\t' '  ')
    else
        systems=$lsfg_default
    fi
    local -a list
    read -r -a list <<<"$systems"   # no glob expansion, so `*` stays literal
    local system arg
    for system in "${list[@]}"; do
        [[ $system == "*" ]] && return 0
        for arg in "$@"; do
            [[ $arg == *"/roms/$system/"* ]] && return 0
        done
    done
    return 1
}

if lsfg_wanted "$@"; then
    exec "$lsfg_script" "$@"
fi
exec "$@"
